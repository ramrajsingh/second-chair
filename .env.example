# Copy to .env and fill in the values.

# --- Neo4j: diligence graph (AuraDB free tier works) ---
NEO4J_URI=neo4j+s://xxxx.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

# --- Crustdata: live people & company data. Leave empty to use data/sample_dossier.json ---
CRUSTDATA_API_KEY=

# --- Sarvam AI: speech-to-text, translation, whisper voice ---
SARVAM_API_KEY=

# --- OpenAI: claim extraction, follow-up questions, memo ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1
